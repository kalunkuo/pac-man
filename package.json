{
  "name": "pacman-arena",
  "private": true,
  "description": "Pac-Man where AI models compete, with a ranking and cost controls",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalunkuo/pac-man.git"
  },
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx --env-file-if-exists=config/.env src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
